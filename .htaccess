# .htaccess for Apache / LiteSpeed / cPanel static hosting
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /jasa to /jasa/ and /artikel to /artikel/
  RewriteRule ^jasa$ /jasa/ [R=301,L]
  RewriteRule ^artikel$ /artikel/ [R=301,L]

  # Allow clean URLs without .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.html
