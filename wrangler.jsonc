{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jasa-temanggung",
  "compatibility_date": "2026-09-26",

  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".wrangler/**",
      "wrangler.jsonc",
      "wrangler.toml",
      "package-lock.json",
      "bun.lock",
      "npm-debug.log*",
      "yarn-debug.log*",
      "yarn-error.log*"
    ],
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
